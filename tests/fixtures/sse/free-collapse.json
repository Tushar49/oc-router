{
  "name": "free-chat-collapse",
  "protocol": "chat",
  "client": {
    "path": "/v1/chat/completions",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer test-key",
      "x-opencode-session": "ses_000000000ffcAAAAAAAAAAAAAA",
      "x-opencode-project": "0123456789abcdef0123456789abcdef01234567"
    },
    "body": {
      "model": "test/free-collapse",
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ],
      "stream": false
    }
  },
  "upstream": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream"
    },
    "sse": "data: {\"id\":\"chatcmpl_collapse\",\"object\":\"chat.completion.chunk\",\"created\":1700000000,\"model\":\"test/free-collapse\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"hello\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"chatcmpl_collapse\",\"object\":\"chat.completion.chunk\",\"created\":1700000000,\"model\":\"test/free-collapse\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":5,\"completion_tokens\":2,\"total_tokens\":7}}\n\ndata: [DONE]\n\n"
  },
  "expect": {
    "status": 200,
    "content_type": "application/json",
    "json": {
      "id": "chatcmpl_collapse",
      "object": "chat.completion",
      "created": 0,
      "model": "test/free-collapse",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "hello"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 5,
        "completion_tokens": 2,
        "total_tokens": 7,
        "prompt_tokens_details": {
          "cached_tokens": 0
        },
        "completion_tokens_details": {
          "reasoning_tokens": 0
        }
      }
    }
  },
  "expect_upstream": {
    "path": "/v1/chat/completions",
    "json": {
      "model": "test/free-collapse",
      "stream": true
    }
  }
