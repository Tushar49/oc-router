{
  "name": "chat-tool-call",
  "protocol": "chat",
  "client": {
    "path": "/v1/chat/completions",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer test-key",
      "x-opencode-session": "ses_000000000ffcAAAAAAAAAAAAAA",
      "x-opencode-project": "0123456789abcdef0123456789abcdef01234567"
    },
    "body": {
      "model": "test/paid-tools",
      "messages": [
        {
          "role": "user",
          "content": "weather?"
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "get_weather",
            "description": "Read the weather",
            "parameters": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ]
            }
          }
        }
      ],
      "stream": false
    }
  },
  "upstream": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "json": {
      "id": "chatcmpl_tools",
      "object": "chat.completion",
      "created": 1700000000,
      "model": "test/paid-tools",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "call_fixture",
                "type": "function",
                "function": {
                  "name": "get_weather",
                  "arguments": "{\"city\":\"testville\"}"
                }
              }
            ]
          },
          "finish_reason": "tool_calls"
        }
      ],
      "usage": {
        "prompt_tokens": 10,
        "completion_tokens": 4,
        "total_tokens": 14
      }
    }
  },
  "expect": {
    "status": 200,
