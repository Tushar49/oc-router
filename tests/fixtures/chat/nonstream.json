{
  "name": "chat-nonstream",
  "protocol": "chat",
  "client": {
    "path": "/v1/chat/completions",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer test-key",
      "x-opencode-session": "ses_000000000ffcAAAAAAAAAAAAAA",
      "x-opencode-project": "0123456789abcdef0123456789abcdef01234567"
    },
    "body": {
      "model": "test/paid-chat",
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ],
      "stream": false
    }
  },
  "upstream": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "json": {
      "id": "chatcmpl_fixture",
      "object": "chat.completion",
      "created": 1700000000,
      "model": "test/paid-chat",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "hello"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 5,
        "completion_tokens": 2,
        "total_tokens": 7
      }
    }
  },
  "expect": {
    "status": 200,
    "content_type": "application/json",
    "json": {
      "id": "chatcmpl_fixture",
      "object": "chat.completion",
      "created": 1700000000,
      "model": "test/paid-chat",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "hello"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 5,
        "completion_tokens": 2,
        "total_tokens": 7
      }
    }
  },
  "expect_upstream": {
    "path": "/v1/chat/completions",
    "json": {
      "model": "test/paid-chat",
      "stream": false,
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ]
    }
  }
}
