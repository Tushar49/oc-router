{
  "name": "chat-to-anthropic",
  "protocol": "chat",
  "client": {
    "path": "/v1/chat/completions",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer test-key",
      "x-opencode-session": "ses_000000000ffcAAAAAAAAAAAAAA",
      "x-opencode-project": "0123456789abcdef0123456789abcdef01234567"
    },
    "body": {
      "model": "test/cross-anthropic",
      "messages": [
        {
          "role": "system",
          "content": "be brief"
        },
        {
          "role": "user",
          "content": "hello"
        }
      ],
      "stream": false
    }
  },
  "upstream": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "json": {
      "id": "msg_fixture",
      "type": "message",
      "role": "assistant",
      "model": "test/cross-anthropic",
      "content": [
        {
          "type": "text",
          "text": "hello"
        }
      ],
      "stop_reason": "end_turn",
      "usage": {
        "input_tokens": 3,
        "output_tokens": 1
      }
    }
  },
  "expect": {
    "status": 200,
    "content_type": "application/json",
    "json": {
      "id": "chatcmpl_fixture",
      "object": "chat.completion",
      "created": 0,
      "model": "test/cross-anthropic",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "hello"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 3,
        "completion_tokens": 1,
        "total_tokens": 4,
        "prompt_tokens_details": {
          "cached_tokens": 0
        },
        "completion_tokens_details": {
          "reasoning_tokens": 0
        }
      }
    }
  },
  "expect_upstream": {
    "path": "/v1/messages?beta=true",
    "json": {
      "model": "test/cross-anthropic",
      "max_tokens": 4096,
      "stream": false,
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "hello"
            }
          ]
        }
      ],
      "system": [
        {
          "type": "text",
          "text": "be brief"
        }
      ]
    }
  }
}
